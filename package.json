{
  "name": "dayman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:native": "VITE_BASE_PATH=./ npm run build",
    "fixtures": "vitest run --config scripts/fixtures.vitest.config.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "release:check": "npm run fixtures && npm test && npm run build && npm run verify:pwa",
    "check:platforms": "bash scripts/check-platforms.sh",
    "check:all": "npm run release:check && npm run check:platforms"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "maplibre-gl": "^6.0.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/tz-lookup": "^6.1.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
