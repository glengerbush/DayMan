<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#101A2D" />
        </shape>
    </item>
    <item android:bottom="30dp" android:left="30dp" android:right="30dp" android:top="30dp">
        <shape android:shape="oval">
            <stroke android:width="12dp" android:color="#FFBD63" />
            <solid android:color="#101A2D" />
        </shape>
    </item>
</layer-list>
