{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayman.app/schema/platform-state-v1.schema.json",
  "title": "DayMan PlatformStateEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "settings",
    "snapshot",
    "snapshots"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "settings": {
      "type": "object",
      "required": ["location"],
      "properties": {
        "location": {
          "type": "object",
          "required": ["label", "latitude", "longitude", "timezone"],
          "properties": {
            "label": { "type": "string" },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "timezone": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "$ref": "clock-snapshot-v1.schema.json"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "clock-snapshot-v1.schema.json"
      }
    }
  },
  "additionalProperties": false
}
