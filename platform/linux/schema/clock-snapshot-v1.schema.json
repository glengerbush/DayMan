{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayman.app/schema/clock-snapshot-v1.schema.json",
  "title": "DayMan ClockSnapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "calculatedAt",
    "expiresAt",
    "dateKey",
    "timezone",
    "location",
    "size",
    "geometry",
    "palette",
    "hourLabels",
    "arcs",
    "events",
    "referenceMinute",
    "currentTimeLabel",
    "nextSolarEvent",
    "moon",
    "accessibilityText"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "calculatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "dateKey": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "required": ["label", "latitude", "longitude"],
      "properties": {
        "label": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "density": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": [
        "viewBox",
        "center",
        "outerRadius",
        "sunRadius",
        "moonRadius",
        "hourLabelRadius",
        "handStartRadius",
        "handEndRadius"
      ],
      "additionalProperties": { "type": "number" }
    },
    "palette": {
      "type": "object",
      "required": [
        "background",
        "face",
        "track",
        "text",
        "mutedText",
        "currentHand"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "hourLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hour", "label", "minute"],
        "properties": {
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "label": { "type": "string" },
          "minute": { "$ref": "#/$defs/minute" }
        },
        "additionalProperties": false
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "label",
          "detail",
          "color",
          "radius",
          "strokeWidth",
          "ranges"
        ],
        "properties": {
          "kind": {
            "enum": ["daylight", "civil", "nautical", "astronomical", "moon"]
          },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "strokeWidth": { "type": "number", "exclusiveMinimum": 0 },
          "ranges": {
            "type": "array",
            "items": { "$ref": "#/$defs/range" }
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "body",
          "marker",
          "label",
          "time",
          "timeLabel",
          "minute",
          "radius",
          "visibleOnDial"
        ],
        "properties": {
          "kind": { "type": "string" },
          "body": { "enum": ["sun", "moon", "twilight"] },
          "marker": { "enum": ["rising", "setting", "peak"] },
          "label": { "type": "string" },
          "time": { "type": "string", "format": "date-time" },
          "timeLabel": { "type": "string" },
          "minute": { "$ref": "#/$defs/minute" },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "visibleOnDial": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "referenceMinute": { "$ref": "#/$defs/minute" },
    "currentTimeLabel": { "type": "string" },
    "nextSolarEvent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "time", "timeLabel", "relativeLabel"],
          "properties": {
            "kind": { "enum": ["sunrise", "sunset"] },
            "time": { "type": "string", "format": "date-time" },
            "timeLabel": { "type": "string" },
            "relativeLabel": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "moon": {
      "type": "object",
      "required": [
        "illumination",
        "phaseAngle",
        "phaseName",
        "markerMinute"
      ],
      "properties": {
        "illumination": { "type": "number", "minimum": 0, "maximum": 1 },
        "phaseAngle": { "type": "number" },
        "phaseName": { "type": "string" },
        "markerMinute": { "$ref": "#/$defs/minute" }
      },
      "additionalProperties": false
    },
    "accessibilityText": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "minute": { "type": "number", "minimum": 0, "maximum": 1440 },
    "range": {
      "type": "object",
      "required": ["startMinute", "endMinute"],
      "properties": {
        "startMinute": { "$ref": "#/$defs/minute" },
        "endMinute": { "$ref": "#/$defs/minute" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
